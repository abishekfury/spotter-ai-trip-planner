# Copy to backend/.env for local use, or set these in your host's dashboard.
DJANGO_DEBUG=true
# Required when DJANGO_DEBUG=false. Generate: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Comma-separated origins of the deployed frontend (only needed if it is served from another domain)
CORS_ALLOWED_ORIGINS=http://localhost:5173
CSRF_TRUSTED_ORIGINS=
# Routing provider (self-host OSRM for production traffic; the public demo has no SLA)
OSRM_BASE_URL=https://router.project-osrm.org
UPSTREAM_TIMEOUT_SECONDS=12
